{
  "name": "chat-cc",
  "version": "4.0.0",
  "description": "飞书 ↔ Claude Code 网关 — Lark Bot 一键接入 Claude Code",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "chat-cc": "dist/cli/index.js",
    "chatcc": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "feishu",
    "lark",
    "claude",
    "claude-code",
    "chatbot",
    "gateway",
    "agent-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CritasWang/chat-cc"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/cli/index.js start --foreground",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.202",
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
